#!/bin/zsh
set -euo pipefail

contents_dir="${0:A:h:h}"
resources_dir="$contents_dir/Resources"
game_dir="$resources_dir/Game"
defaults_dir="$resources_dir/Defaults"
factory_database="$defaults_dir/Database.tdb"
data_dir="${BALLANCE_USER_DATA_DIR:-$HOME/Library/Application Support/Ballance}"

# Run before seeding defaults, so genuine legacy settings retain precedence.
# Conflicting native files are retained and the legacy copy is backed up.
"$contents_dir/MacOS/MigrateUserData" "$data_dir"

mkdir -p \
  "$data_dir/ModLoader/Maps" \
  "$data_dir/ModLoader/Mods" \
  "$data_dir/ModLoader/Configs" \
  "$data_dir/ModLoader/Fonts" \
  "$data_dir/ModLoader/Themes" \
  "$data_dir/ModLoader/TAS" \
  "$data_dir/Screenshots"

# Preserve scores from a legacy bundle that was updated in place or from the
# earlier Wine bundle on the first native launch. Otherwise seed the writable
# database from the app's read-only defaults.
if [[ ! -e "$data_dir/Database.tdb" && -f "$game_dir/Database.tdb" ]]; then
  cp "$game_dir/Database.tdb" "$data_dir/Database.tdb"
fi
if [[ ! -e "$data_dir/Database.tdb" && -f "$data_dir/Game/Database.tdb" ]]; then
  cp "$data_dir/Game/Database.tdb" "$data_dir/Database.tdb"
fi
if [[ ! -e "$data_dir/Database.tdb" && -f "$factory_database" ]]; then
  cp "$factory_database" "$data_dir/Database.tdb"
fi

# Preserve user-installed maps from both layouts used by earlier bundles.
for legacy_maps in "$data_dir/Maps" "$data_dir/Game/ModLoader/Maps"; do
  if [[ -d "$legacy_maps" ]]; then
    while IFS= read -r -d '' source; do
      destination="$data_dir/ModLoader/Maps/${source:t}"
      [[ -e "$destination" ]] || cp "$source" "$destination"
    done < <(find "$legacy_maps" -maxdepth 1 -type f \( -iname '*.nmo' -o -iname '*.cmo' \) -print0)
  fi
done

# Seed BML's redistributable UI resources without replacing user edits.
if [[ -d "$defaults_dir/ModLoader" ]]; then
  while IFS= read -r -d '' source; do
    relative="${source#$defaults_dir/ModLoader/}"
    destination="$data_dir/ModLoader/$relative"
    mkdir -p "${destination:h}"
    [[ -e "$destination" ]] || cp "$source" "$destination"
  done < <(find "$defaults_dir/ModLoader" -type f -print0)
fi

# These native binaries are maintained as part of this application build.
# Refresh them when the bundle changes while leaving every third-party mod
# entirely under the user's control.
for managed_mod in PracticeTools.bmodp SpeedrunShortcuts.bmodp BallanceTAS.bmodp LegacyTASRuntime.bmodp; do
  source="$defaults_dir/ModLoader/Mods/$managed_mod"
  destination="$data_dir/ModLoader/Mods/$managed_mod"
  if [[ -f "$source" ]] && ! cmp -s "$source" "$destination"; then
    cp "$source" "$destination"
  fi
done

exec "$game_dir/Bin/Player" \
  --root-path "$game_dir" \
  --user-data-path "$data_dir" \
  "$@"
