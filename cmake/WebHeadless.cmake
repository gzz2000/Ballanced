# Initial cache for the first WebAssembly qualification stage. This is a
# Node-hosted WASM runner with host filesystem access, NOT the browser release.
set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "WASM dynamic-link compatible objects")
set(BALLANCE_BUILD_STATIC ON CACHE BOOL "")
set(CKRE_BUILD_SDL_GPU_RASTERIZER OFF CACHE BOOL "")
set(CKPLUGINS_BUILD_AVIREADER ON CACHE BOOL "")
set(IVP_ENABLE_X87_EMULATION ON CACHE BOOL "")
set(IVP_BUILD_ARITHMETIC_TESTS ON CACHE BOOL "")
set(IVP_BUILD_CHECKPOINT_TESTS ON CACHE BOOL "")
set(BML_BUILD_HOST_TESTS ON CACHE BOOL "")
set(CK2_BUILD_STATIC_HOST_TESTS ON CACHE BOOL "")
set(VXMATH_SIMD_PROVIDER SIMDE CACHE STRING "")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_C_FLAGS "-ffp-contract=off" CACHE STRING "")
set(CMAKE_CXX_FLAGS "-ffp-contract=off -fexceptions" CACHE STRING "")
set(CMAKE_EXE_LINKER_FLAGS
    "-g2 -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=8388608 -sASSERTIONS=1 -sEXIT_RUNTIME=1 -sENVIRONMENT=node -sNODERAWFS=1"
    CACHE STRING "")
